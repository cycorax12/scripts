{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "padding": 10,

  "signals": [
    {
      "name": "selectedField",
      "value": "processing_status",
      "bind": {
        "input": "select",
        "name": "Changed Field: ",
        "options": [
          "processing_status",
          "box_location",
          "manual_adjustment",
          "dtc_tracking_marker",
          "comp_claim_type",
          "contra_required",
          "special_bargain_condition",
          "qsl_marker",
          "swt_flag",
          "swt_flag_manual",
          "franking"
        ]
      }
    }
  ],

  "data": [
    {
      "name": "raw",
      "url": {
        "index": "aspen-positions-mtp",
        "body": {
          "size": 0,
          "aggs": {
            "changes_nested": {
              "nested": {
                "path": "changes"
              },
              "aggs": {
                "fields": {
                  "terms": {
                    "field": "changes.field",
                    "size": 100
                  },
                  "aggs": {
                    "changed_values": {
                      "terms": {
                        "field": "changes.value",
                        "size": 100
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.changes_nested.fields.buckets"
      }
    },

    {
      "name": "values",
      "source": "raw",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.key === selectedField"
        },
        {
          "type": "flatten",
          "fields": ["changed_values.buckets"],
          "as": ["item"]
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "values",
        "field": "item.key"
      },
      "range": "height",
      "padding": 0.15
    },

    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "values",
        "field": "item.doc_count"
      },
      "range": "width",
      "zero": true,
      "nice": true
    }
  ],

  "axes": [
    {
      "scale": "y",
      "orient": "left",
      "title": "Changed Value"
    },
    {
      "scale": "x",
      "orient": "bottom",
      "title": "Count"
    }
  ],

  "marks": [
    {
      "name": "valueOption",
      "type": "rect",
      "from": {
        "data": "values"
      },

      "encode": {
        "enter": {
          "y": {
            "scale": "y",
            "field": "item.key"
          },

          "height": {
            "scale": "y",
            "band": 1
          },

          "x": {
            "scale": "x",
            "value": 0
          },

          "x2": {
            "scale": "x",
            "field": "item.doc_count"
          },

          "cursor": {
            "value": "pointer"
          },

          "tooltip": {
            "signal": "{'Changed Field': selectedField, 'Changed Value': datum.item.key, 'Count': datum.item.doc_count}"
          }
        }
      }
    }
  ]
}