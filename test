{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",

  "data": {
    "url": {
      "index": "aspen-positions-mtp",
      "body": {
        "size": 0,
        "aggs": {
          "changes": {
            "nested": {
              "path": "changes"
            },
            "aggs": {
              "selected_field": {
                "filter": {
                  "term": {
                    "changes.field": "processing_status"
                  }
                },
                "aggs": {
                  "values": {
                    "terms": {
                      "field": "changes.value",
                      "size": 100
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "format": {
      "property": "aggregations.changes.selected_field.values.buckets"
    }
  },

  "mark": {
    "type": "bar",
    "tooltip": true
  },

  "encoding": {
    "y": {
      "field": "key",
      "type": "nominal",
      "title": "Processing Status"
    },
    "x": {
      "field": "doc_count",
      "type": "quantitative",
      "title": "Count"
    }
  }
}