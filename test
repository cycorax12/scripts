{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "padding": 10,

  "config": {
    "kibana": {
      "restoreSignalValuesOnRefresh": true
    }
  },

  "signals": [
    {
      "name": "selectedField",
      "value": "Select field",
      "on": [
        {
          "events": "@fieldItem:click",
          "update": "datum.key"
        },
        {
          "events": "@fieldItemText:click",
          "update": "datum.key"
        }
      ]
    },

    {
      "name": "selectedValue",
      "value": "Select value",
      "on": [
        {
          "events": "@valueItem:click",
          "update": "datum.item.key"
        },
        {
          "events": "@valueItemText:click",
          "update": "datum.item.key"
        },
        {
          "events": "@fieldItem:click",
          "update": "'Select value'"
        },
        {
          "events": "@fieldItemText:click",
          "update": "'Select value'"
        }
      ]
    },

    {
      "name": "fieldDropdownOpen",
      "value": false,
      "on": [
        {
          "events": "@fieldSelector:click",
          "update": "!fieldDropdownOpen"
        },
        {
          "events": "@fieldSelectorText:click",
          "update": "!fieldDropdownOpen"
        },
        {
          "events": "@fieldSelectorArrow:click",
          "update": "!fieldDropdownOpen"
        },
        {
          "events": "@fieldItem:click",
          "update": "false"
        },
        {
          "events": "@fieldItemText:click",
          "update": "false"
        },
        {
          "events": "@valueSelector:click",
          "update": "false"
        }
      ]
    },

    {
      "name": "valueDropdownOpen",
      "value": false,
      "on": [
        {
          "events": "@valueSelector:click",
          "update": "selectedField != 'Select field' ? !valueDropdownOpen : false"
        },
        {
          "events": "@valueSelectorText:click",
          "update": "selectedField != 'Select field' ? !valueDropdownOpen : false"
        },
        {
          "events": "@valueSelectorArrow:click",
          "update": "selectedField != 'Select field' ? !valueDropdownOpen : false"
        },
        {
          "events": "@valueItem:click",
          "update": "false"
        },
        {
          "events": "@valueItemText:click",
          "update": "false"
        },
        {
          "events": "@fieldSelector:click",
          "update": "false"
        },
        {
          "events": "@fieldItem:click",
          "update": "false"
        }
      ]
    },

    {
      "name": "fieldPage",
      "value": 0,
      "on": [
        {
          "events": "@fieldNext:click",
          "update": "fieldPage + 1"
        },
        {
          "events": "@fieldPrev:click",
          "update": "max(0, fieldPage - 1)"
        },
        {
          "events": "@fieldItem:click",
          "update": "0"
        }
      ]
    },

    {
      "name": "valuePage",
      "value": 0,
      "on": [
        {
          "events": "@valueNext:click",
          "update": "valuePage + 1"
        },
        {
          "events": "@valuePrev:click",
          "update": "max(0, valuePage - 1)"
        },
        {
          "events": "@fieldItem:click",
          "update": "0"
        },
        {
          "events": "@valueItem:click",
          "update": "0"
        }
      ]
    },

    {
      "name": "activeField",
      "value": "",
      "on": [
        {
          "events": "@fieldItem:click",
          "update": "datum.key"
        },
        {
          "events": "@fieldItemText:click",
          "update": "datum.key"
        }
      ]
    },

    {
      "name": "activeValue",
      "value": "",
      "on": [
        {
          "events": "@valueItem:click",
          "update": "datum.item.key"
        },
        {
          "events": "@valueItemText:click",
          "update": "datum.item.key"
        },
        {
          "events": "@fieldItem:click",
          "update": "''"
        },
        {
          "events": "@fieldItemText:click",
          "update": "''"
        }
      ]
    },

    {
      "name": "removePreviousOnField",
      "value": null,
      "on": [
        {
          "events": "@fieldItem:click",
          "update": "activeField != '' ? (activeValue != '' ? kibanaRemoveFilter({'nested': {'path': 'changes', 'query': {'bool': {'filter': [{'term': {'changes.field': activeField}}, {'term': {'changes.value': activeValue}}]}}}}, 'aspen-positions-mtp') : kibanaRemoveFilter({'nested': {'path': 'changes', 'query': {'term': {'changes.field': activeField}}}}, 'aspen-positions-mtp')) : null"
        },
        {
          "events": "@fieldItemText:click",
          "update": "activeField != '' ? (activeValue != '' ? kibanaRemoveFilter({'nested': {'path': 'changes', 'query': {'bool': {'filter': [{'term': {'changes.field': activeField}}, {'term': {'changes.value': activeValue}}]}}}}, 'aspen-positions-mtp') : kibanaRemoveFilter({'nested': {'path': 'changes', 'query': {'term': {'changes.field': activeField}}}}, 'aspen-positions-mtp')) : null"
        }
      ]
    },

    {
      "name": "applyFieldFilter",
      "value": null,
      "on": [
        {
          "events": "@fieldItem:click",
          "update": "kibanaAddFilter({'nested': {'path': 'changes', 'query': {'term': {'changes.field': datum.key}}}}, 'aspen-positions-mtp', datum.key)"
        },
        {
          "events": "@fieldItemText:click",
          "update": "kibanaAddFilter({'nested': {'path': 'changes', 'query': {'term': {'changes.field': datum.key}}}}, 'aspen-positions-mtp', datum.key)"
        }
      ]
    },

    {
      "name": "removeBeforeValue",
      "value": null,
      "on": [
        {
          "events": "@valueItem:click",
          "update": "activeValue != '' ? kibanaRemoveFilter({'nested': {'path': 'changes', 'query': {'bool': {'filter': [{'term': {'changes.field': activeField}}, {'term': {'changes.value': activeValue}}]}}}}, 'aspen-positions-mtp') : kibanaRemoveFilter({'nested': {'path': 'changes', 'query': {'term': {'changes.field': activeField}}}}, 'aspen-positions-mtp')"
        },
        {
          "events": "@valueItemText:click",
          "update": "activeValue != '' ? kibanaRemoveFilter({'nested': {'path': 'changes', 'query': {'bool': {'filter': [{'term': {'changes.field': activeField}}, {'term': {'changes.value': activeValue}}]}}}}, 'aspen-positions-mtp') : kibanaRemoveFilter({'nested': {'path': 'changes', 'query': {'term': {'changes.field': activeField}}}}, 'aspen-positions-mtp')"
        }
      ]
    },

    {
      "name": "applyValueFilter",
      "value": null,
      "on": [
        {
          "events": "@valueItem:click",
          "update": "kibanaAddFilter({'nested': {'path': 'changes', 'query': {'bool': {'filter': [{'term': {'changes.field': selectedField}}, {'term': {'changes.value': datum.item.key}}]}}}}, 'aspen-positions-mtp', selectedField + ': ' + datum.item.key)"
        },
        {
          "events": "@valueItemText:click",
          "update": "kibanaAddFilter({'nested': {'path': 'changes', 'query': {'bool': {'filter': [{'term': {'changes.field': selectedField}}, {'term': {'changes.value': datum.item.key}}]}}}}, 'aspen-positions-mtp', selectedField + ': ' + datum.item.key)"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "raw",
      "url": {
        "index": "aspen-positions-mtp",
        "body": {
          "size": 0,
          "aggs": {
            "changes_nested": {
              "nested": {
                "path": "changes"
              },
              "aggs": {
                "fields": {
                  "terms": {
                    "field": "changes.field",
                    "size": 100
                  },
                  "aggs": {
                    "changed_values": {
                      "terms": {
                        "field": "changes.value",
                        "size": 100
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.changes_nested.fields.buckets"
      }
    },

    {
      "name": "fields",
      "source": "raw",
      "transform": [
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["row"]
        }
      ]
    },

    {
      "name": "fieldOptions",
      "source": "fields",
      "transform": [
        {
          "type": "filter",
          "expr": "fieldDropdownOpen && datum.row > fieldPage * 5 && datum.row <= (fieldPage + 1) * 5"
        },
        {
          "type": "formula",
          "expr": "datum.row - fieldPage * 5",
          "as": "displayRow"
        }
      ]
    },

    {
      "name": "values",
      "source": "raw",
      "transform": [
        {
          "type": "filter",
          "expr": "selectedField != 'Select field' && datum.key === selectedField"
        },
        {
          "type": "flatten",
          "fields": ["changed_values.buckets"],
          "as": ["item"]
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["row"]
        }
      ]
    },

    {
      "name": "valueOptions",
      "source": "values",
      "transform": [
        {
          "type": "filter",
          "expr": "valueDropdownOpen && datum.row > valuePage * 5 && datum.row <= (valuePage + 1) * 5"
        },
        {
          "type": "formula",
          "expr": "datum.row - valuePage * 5",
          "as": "displayRow"
        }
      ]
    }
  ],

  "marks": [
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 10},
          "y": {"value": 29},
          "text": {"value": "Changed Field:"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"}
        }
      }
    },

    {
      "name": "fieldSelector",
      "type": "rect",
      "encode": {
        "enter": {
          "x": {"value": 115},
          "y": {"value": 7},
          "width": {"value": 220},
          "height": {"value": 32},
          "stroke": {"value": "#888"},
          "cornerRadius": {"value": 3},
          "cursor": {"value": "pointer"}
        },
        "update": {
          "fill": {"value": "white"}
        }
      }
    },

    {
      "name": "fieldSelectorText",
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 125},
          "y": {"value": 28},
          "fontSize": {"value": 13},
          "fill": {"value": "black"},
          "cursor": {"value": "pointer"}
        },
        "update": {
          "text": {"signal": "selectedField"}
        }
      }
    },

    {
      "name": "fieldSelectorArrow",
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 315},
          "y": {"value": 28},
          "text": {"value": "▼"},
          "fontSize": {"value": 11},
          "fill": {"value": "black"},
          "cursor": {"value": "pointer"}
        }
      }
    },

    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 370},
          "y": {"value": 29},
          "text": {"value": "Changed Value:"},
          "fontSize": {"value": 13},
          "fontWeight": {"value": "bold"}
        }
      }
    },

    {
      "name": "valueSelector",
      "type": "rect",
      "encode": {
        "enter": {
          "x": {"value": 485},
          "y": {"value": 7},
          "width": {"value": 220},
          "height": {"value": 32},
          "stroke": {"value": "#888"},
          "cornerRadius": {"value": 3},
          "cursor": {"value": "pointer"}
        },
        "update": {
          "fill": {"value": "white"},
          "opacity": {
            "signal": "selectedField == 'Select field' ? 0.6 : 1"
          }
        }
      }
    },

    {
      "name": "valueSelectorText",
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 495},
          "y": {"value": 28},
          "fontSize": {"value": 13},
          "fill": {"value": "black"},
          "cursor": {"value": "pointer"}
        },
        "update": {
          "text": {
            "signal": "selectedField == 'Select field' ? 'Select field first' : selectedValue"
          }
        }
      }
    },

    {
      "name": "valueSelectorArrow",
      "type": "text",
      "encode": {
        "enter": {
          "x": {"value": 685},
          "y": {"value": 28},
          "text": {"value": "▼"},
          "fontSize": {"value": 11},
          "fill": {"value": "black"},
          "cursor": {"value": "pointer"}
        }
      }
    },

    {
      "name": "fieldItem",
      "type": "rect",
      "from": {"data": "fieldOptions"},
      "encode": {
        "enter": {
          "x": {"value": 115},
          "width": {"value": 220},
          "height": {"value": 30},
          "fill": {"value": "white"},
          "stroke": {"value": "#ddd"},
          "cursor": {"value": "pointer"}
        },
        "update": {
          "y": {
            "signal": "45 + ((datum.displayRow - 1) * 30)"
          }
        }
      }
    },

    {
      "name": "fieldItemText",
      "type": "text",
      "from": {"data": "fieldOptions"},
      "encode": {
        "enter": {
          "x": {"value": 125},
          "fontSize": {"value": 13},
          "fill": {"value": "black"},
          "cursor": {"value": "pointer"}
        },
        "update": {
          "y": {
            "signal": "65 + ((datum.displayRow - 1) * 30)"
          },
          "text": {"field": "key"}
        }
      }
    },

    {
      "name": "fieldPrev",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 125},
          "y": {"value": 215},
          "text": {"value": "▲ Previous"},
          "fontSize": {"value": 12},
          "cursor": {"value": "pointer"},
          "opacity": {
            "signal": "fieldDropdownOpen && fieldPage > 0 ? 1 : 0"
          }
        }
      }
    },

    {
      "name": "fieldNext",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 250},
          "y": {"value": 215},
          "text": {"value": "Next ▼"},
          "fontSize": {"value": 12},
          "cursor": {"value": "pointer"},
          "opacity": {
            "signal": "fieldDropdownOpen ? 1 : 0"
          }
        }
      }
    },

    {
      "name": "valueItem",
      "type": "rect",
      "from": {"data": "valueOptions"},
      "encode": {
        "enter": {
          "x": {"value": 485},
          "width": {"value": 220},
          "height": {"value": 30},
          "fill": {"value": "white"},
          "stroke": {"value": "#ddd"},
          "cursor": {"value": "pointer"}
        },
        "update": {
          "y": {
            "signal": "45 + ((datum.displayRow