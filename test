{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "padding": 10,

  "config": {
    "kibana": {
      "restoreSignalValuesOnRefresh": true
    }
  },

  "signals": [
    {
      "name": "selectedField",
      "value": "processing_status",
      "bind": {
        "input": "select",
        "name": "Changed Field: ",
        "options": [
          "processing_status",
          "box_location",
          "manual_adjustment",
          "dtc_tracking_marker",
          "comp_claim_type",
          "contra_required",
          "special_bargain_condition",
          "qsl_marker",
          "swt_flag",
          "swt_flag_manual",
          "franking"
        ]
      }
    },

    {
      "name": "selectedValue",
      "value": "Select value",
      "on": [
        {
          "events": "@valueItem:click",
          "update": "datum.item.key"
        },
        {
          "events": "@valueItemText:click",
          "update": "datum.item.key"
        },
        {
          "events": {
            "signal": "selectedField"
          },
          "update": "'Select value'"
        }
      ]
    },

    {
      "name": "dropdownOpen",
      "value": false,
      "on": [
        {
          "events": "@valueSelector:click",
          "update": "!dropdownOpen"
        },
        {
          "events": "@valueSelectorText:click",
          "update": "!dropdownOpen"
        },
        {
          "events": "@valueSelectorArrow:click",
          "update": "!dropdownOpen"
        },
        {
          "events": "@valueItem:click",
          "update": "false"
        },
        {
          "events": "@valueItemText:click",
          "update": "false"
        }
      ]
    },

    {
      "name": "applyDashboardFilter",
      "value": null,
      "on": [
        {
          "events": "@valueItem:click",
          "update": "kibanaAddFilter({'nested': {'path': 'changes', 'query': {'bool': {'filter': [{'term': {'changes.field': selectedField}}, {'term': {'changes.value': datum.item.key}}]}}}}, 'aspen-positions-mtp', selectedField + ': ' + datum.item.key)"
        },
        {
          "events": "@valueItemText:click",
          "update": "kibanaAddFilter({'nested': {'path': 'changes', 'query': {'bool': {'filter': [{'term': {'changes.field': selectedField}}, {'term': {'changes.value': datum.item.key}}]}}}}, 'aspen-positions-mtp', selectedField + ': ' + datum.item.key)"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "raw",
      "url": {
        "index": "aspen-positions-mtp",
        "body": {
          "size": 0,
          "aggs": {
            "changes_nested": {
              "nested": {
                "path": "changes"
              },
              "aggs": {
                "fields": {
                  "terms": {
                    "field": "changes.field",
                    "size": 100
                  },
                  "aggs": {
                    "changed_values": {
                      "terms": {
                        "field": "changes.value",
                        "size": 100
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },

      "format": {
        "property": "aggregations.changes_nested.fields.buckets"
      }
    },

    {
      "name": "values",
      "source": "raw",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.key === selectedField"
        },
        {
          "type": "flatten",
          "fields": [
            "changed_values.buckets"
          ],
          "as": [
            "item"
          ]
        },
        {
          "type": "window",
          "ops": [
            "row_number"
          ],
          "as": [
            "row"
          ]
        }
      ]
    }
  ],

  "marks": [
    {
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 10
          },
          "y": {
            "value": 35
          },
          "text": {
            "value": "Changed Value:"
          },
          "fontSize": {
            "value": 13
          },
          "fontWeight": {
            "value": "bold"
          }
        }
      }
    },

    {
      "name": "valueSelector",
      "type": "rect",
      "encode": {
        "enter": {
          "x": {
            "value": 120
          },
          "y": {
            "value": 15
          },
          "width": {
            "value": 260
          },
          "height": {
            "value": 32
          },
          "stroke": {
            "value": "#888"
          },
          "cornerRadius": {
            "value": 3
          },
          "cursor": {
            "value": "pointer"
          }
        },

        "update": {
          "fill": {
            "value": "white"
          }
        }
      }
    },

    {
      "name": "valueSelectorText",
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 130
          },
          "y": {
            "value": 36
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "black"
          },
          "cursor": {
            "value": "pointer"
          }
        },

        "update": {
          "text": {
            "signal": "selectedValue"
          }
        }
      }
    },

    {
      "name": "valueSelectorArrow",
      "type": "text",
      "encode": {
        "enter": {
          "x": {
            "value": 360
          },
          "y": {
            "value": 36
          },
          "text": {
            "value": "▼"
          },
          "fontSize": {
            "value": 12
          },
          "fill": {
            "value": "black"
          },
          "cursor": {
            "value": "pointer"
          }
        }
      }
    },

    {
      "name": "valueItem",
      "type": "rect",
      "from": {
        "data": "values"
      },

      "encode": {
        "update": {
          "x": {
            "value": 120
          },
          "y": {
            "signal": "52 + ((datum.row - 1) * 30)"
          },
          "width": {
            "value": 260
          },
          "height": {
            "value": 30
          },
          "fill": {
            "value": "white"
          },
          "stroke": {
            "value": "#ddd"
          },
          "cursor": {
            "value": "pointer"
          },
          "opacity": {
            "signal": "dropdownOpen ? 1 : 0"
          }
        }
      }
    },

    {
      "name": "valueItemText",
      "type": "text",
      "from": {
        "data": "values"
      },

      "encode": {
        "update": {
          "x": {
            "value": 130
          },
          "y": {
            "signal": "72 + ((datum.row - 1) * 30)"
          },
          "text": {
            "field": "item.key"
          },
          "fontSize": {
            "value": 13
          },
          "fill": {
            "value": "black"
          },
          "cursor": {
            "value": "pointer"
          },
          "opacity": {
            "signal": "dropdownOpen ? 1 : 0"
          }
        }
      }
    }
  ]
}