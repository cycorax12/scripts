{
  "$schema": "https://vega.github.io/schema/vega/v5.json",

  "signals": [
    {
      "name": "selectedField",
      "value": "processing_status",
      "bind": {
        "input": "select",
        "name": "Changed Field: ",
        "options": [
          "processing_status",
          "box_location"
        ]
      }
    }
  ],

  "data": [
    {
      "name": "test",
      "values": [
        {
          "field": "processing_status",
          "value": "Exclude",
          "count": 100
        },
        {
          "field": "processing_status",
          "value": "Include",
          "count": 50
        },
        {
          "field": "box_location",
          "value": "SCM",
          "count": 80
        },
        {
          "field": "box_location",
          "value": "NYC",
          "count": 30
        }
      ],
      "transform": [
        {
          "type": "filter",
          "expr": "datum.field === selectedField"
        }
      ]
    }
  ],

  "scales": [
    {
      "name": "x",
      "type": "linear",
      "domain": {
        "data": "test",
        "field": "count"
      },
      "range": "width",
      "zero": true
    },
    {
      "name": "y",
      "type": "band",
      "domain": {
        "data": "test",
        "field": "value"
      },
      "range": "height",
      "padding": 0.2
    }
  ],

  "axes": [
    {
      "scale": "x",
      "orient": "bottom",
      "title": "Count"
    },
    {
      "scale": "y",
      "orient": "left",
      "title": "Changed Value"
    }
  ],

  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "test"
      },
      "encode": {
        "enter": {
          "x": {
            "scale": "x",
            "value": 0
          },
          "x2": {
            "scale": "x",
            "field": "count"
          },
          "y": {
            "scale": "y",
            "field": "value"
          },
          "height": {
            "scale": "y",
            "band": 1
          }
        }
      }
    }
  ]
}