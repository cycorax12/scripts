{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "padding": 10,

  "config": {
    "kibana": {
      "restoreSignalValuesOnRefresh": true
    }
  },

  "signals": [
    {
      "name": "mode",
      "value": "main",
      "on": [
        {"events": "@fieldBox:click", "update": "'field'"},
        {"events": "@fieldText:click", "update": "'field'"},
        {"events": "@valueBox:click", "update": "selectedField != '' ? 'value' : 'main'"},
        {"events": "@valueText:click", "update": "selectedField != '' ? 'value' : 'main'"},
        {"events": "@closeButton:click", "update": "'main'"},
        {"events": "@fieldOption:click", "update": "'main'"},
        {"events": "@fieldOptionText:click", "update": "'main'"},
        {"events": "@valueOption:click", "update": "'main'"},
        {"events": "@valueOptionText:click", "update": "'main'"}
      ]
    },

    {
      "name": "selectedField",
      "value": "",
      "on": [
        {"events": "@fieldOption:click", "update": "datum.key"},
        {"events": "@fieldOptionText:click", "update": "datum.key"}
      ]
    },

    {
      "name": "selectedValue",
      "value": "",
      "on": [
        {"events": "@valueOption:click", "update": "datum.item.key"},
        {"events": "@valueOptionText:click", "update": "datum.item.key"},
        {"events": "@fieldOption:click", "update": "''"},
        {"events": "@fieldOptionText:click", "update": "''"}
      ]
    },

    {
      "name": "page",
      "value": 0,
      "on": [
        {"events": "@nextButton:click", "update": "page + 1"},
        {"events": "@prevButton:click", "update": "max(0,page-1)"},
        {"events": "@fieldBox:click", "update": "0"},
        {"events": "@fieldText:click", "update": "0"},
        {"events": "@valueBox:click", "update": "0"},
        {"events": "@valueText:click", "update": "0"}
      ]
    },

    {
      "name": "activeField",
      "value": "",
      "on": [
        {"events": "@fieldOption:click", "update": "datum.key"},
        {"events": "@fieldOptionText:click", "update": "datum.key"}
      ]
    },

    {
      "name": "activeValue",
      "value": "",
      "on": [
        {"events": "@valueOption:click", "update": "datum.item.key"},
        {"events": "@valueOptionText:click", "update": "datum.item.key"},
        {"events": "@fieldOption:click", "update": "''"},
        {"events": "@fieldOptionText:click", "update": "''"}
      ]
    },

    {
      "name": "removeOldOnField",
      "value": null,
      "on": [
        {
          "events": "@fieldOption:click",
          "update": "activeField != '' ? (activeValue != '' ? kibanaRemoveFilter({'nested':{'path':'changes','query':{'bool':{'filter':[{'term':{'changes.field':activeField}},{'term':{'changes.value':activeValue}}]}}}},'aspen-positions-mtp') : kibanaRemoveFilter({'nested':{'path':'changes','query':{'term':{'changes.field':activeField}}}},'aspen-positions-mtp')) : null"
        },
        {
          "events": "@fieldOptionText:click",
          "update": "activeField != '' ? (activeValue != '' ? kibanaRemoveFilter({'nested':{'path':'changes','query':{'bool':{'filter':[{'term':{'changes.field':activeField}},{'term':{'changes.value':activeValue}}]}}}},'aspen-positions-mtp') : kibanaRemoveFilter({'nested':{'path':'changes','query':{'term':{'changes.field':activeField}}}},'aspen-positions-mtp')) : null"
        }
      ]
    },

    {
      "name": "applyField",
      "value": null,
      "on": [
        {
          "events": "@fieldOption:click",
          "update": "kibanaAddFilter({'nested':{'path':'changes','query':{'term':{'changes.field':datum.key}}}},'aspen-positions-mtp',datum.key)"
        },
        {
          "events": "@fieldOptionText:click",
          "update": "kibanaAddFilter({'nested':{'path':'changes','query':{'term':{'changes.field':datum.key}}}},'aspen-positions-mtp',datum.key)"
        }
      ]
    },

    {
      "name": "removeOldOnValue",
      "value": null,
      "on": [
        {
          "events": "@valueOption:click",
          "update": "activeValue != '' ? kibanaRemoveFilter({'nested':{'path':'changes','query':{'bool':{'filter':[{'term':{'changes.field':activeField}},{'term':{'changes.value':activeValue}}]}}}},'aspen-positions-mtp') : kibanaRemoveFilter({'nested':{'path':'changes','query':{'term':{'changes.field':activeField}}}},'aspen-positions-mtp')"
        },
        {
          "events": "@valueOptionText:click",
          "update": "activeValue != '' ? kibanaRemoveFilter({'nested':{'path':'changes','query':{'bool':{'filter':[{'term':{'changes.field':activeField}},{'term':{'changes.value':activeValue}}]}}}},'aspen-positions-mtp') : kibanaRemoveFilter({'nested':{'path':'changes','query':{'term':{'changes.field':activeField}}}},'aspen-positions-mtp')"
        }
      ]
    },

    {
      "name": "applyValue",
      "value": null,
      "on": [
        {
          "events": "@valueOption:click",
          "update": "kibanaAddFilter({'nested':{'path':'changes','query':{'bool':{'filter':[{'term':{'changes.field':selectedField}},{'term':{'changes.value':datum.item.key}}]}}}},'aspen-positions-mtp',selectedField + ': ' + datum.item.key)"
        },
        {
          "events": "@valueOptionText:click",
          "update": "kibanaAddFilter({'nested':{'path':'changes','query':{'bool':{'filter':[{'term':{'changes.field':selectedField}},{'term':{'changes.value':datum.item.key}}]}}}},'aspen-positions-mtp',selectedField + ': ' + datum.item.key)"
        }
      ]
    }
  ],

  "data": [
    {
      "name": "raw",
      "url": {
        "index": "aspen-positions-mtp",
        "body": {
          "size": 0,
          "aggs": {
            "changes_nested": {
              "nested": {"path": "changes"},
              "aggs": {
                "fields": {
                  "terms": {
                    "field": "changes.field",
                    "size": 100
                  },
                  "aggs": {
                    "changed_values": {
                      "terms": {
                        "field": "changes.value",
                        "size": 100
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "format": {
        "property": "aggregations.changes_nested.fields.buckets"
      }
    },

    {
      "name": "fields",
      "source": "raw",
      "transform": [
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["row"]
        }
      ]
    },

    {
      "name": "values",
      "source": "raw",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.key === selectedField"
        },
        {
          "type": "flatten",
          "fields": ["changed_values.buckets"],
          "as": ["item"]
        },
        {
          "type": "window",
          "ops": ["row_number"],
          "as": ["row"]
        }
      ]
    },

    {
      "name": "fieldPage",
      "source": "fields",
      "transform": [
        {
          "type": "filter",
          "expr": "mode == 'field' && datum.row > page*5 && datum.row <= (page+1)*5"
        },
        {
          "type": "formula",
          "expr": "datum.row-page*5",
          "as": "displayRow"
        }
      ]
    },

    {
      "name": "valuePage",
      "source": "values",
      "transform": [
        {
          "type": "filter",
          "expr": "mode == 'value' && datum.row > page*5 && datum.row <= (page+1)*5"
        },
        {
          "type": "formula",
          "expr": "datum.row-page*5",
          "as": "displayRow"
        }
      ]
    }
  ],

  "marks": [
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 10},
          "y": {"value": 28},
          "text": {"value": "Changed Field"},
          "fontWeight": {"value": "bold"},
          "fontSize": {"value": 13},
          "opacity": {"signal": "mode == 'main' ? 1 : 0"}
        }
      }
    },

    {
      "name": "fieldBox",
      "type": "rect",
      "encode": {
        "update": {
          "x": {"value": 110},
          "y": {"value": 7},
          "width": {"value": 220},
          "height": {"value": 32},
          "fill": {"value": "white"},
          "stroke": {"value": "#888"},
          "cornerRadius": {"value": 3},
          "cursor": {"value": "pointer"},
          "opacity": {"signal": "mode == 'main' ? 1 : 0"}
        }
      }
    },

    {
      "name": "fieldText",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 120},
          "y": {"value": 28},
          "text": {
            "signal": "selectedField == '' ? 'Select field' : selectedField"
          },
          "fontSize": {"value": 13},
          "cursor": {"value": "pointer"},
          "opacity": {"signal": "mode == 'main' ? 1 : 0"}
        }
      }
    },

    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 350},
          "y": {"value": 28},
          "text": {"value": "Changed Value"},
          "fontWeight": {"value": "bold"},
          "fontSize": {"value": 13},
          "opacity": {"signal": "mode == 'main' ? 1 : 0"}
        }
      }
    },

    {
      "name": "valueBox",
      "type": "rect",
      "encode": {
        "update": {
          "x": {"value": 460},
          "y": {"value": 7},
          "width": {"value": 220},
          "height": {"value": 32},
          "fill": {"value": "white"},
          "stroke": {"value": "#888"},
          "cornerRadius": {"value": 3},
          "cursor": {"value": "pointer"},
          "opacity": {"signal": "mode == 'main' ? 1 : 0"}
        }
      }
    },

    {
      "name": "valueText",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 470},
          "y": {"value": 28},
          "text": {
            "signal": "selectedField == '' ? 'Select field first' : selectedValue == '' ? 'Select value' : selectedValue"
          },
          "fontSize": {"value": 13},
          "cursor": {"value": "pointer"},
          "opacity": {"signal": "mode == 'main' ? 1 : 0"}
        }
      }
    },

    {
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 10},
          "y": {"value": 28},
          "text": {
            "signal": "mode == 'field' ? 'Select Changed Field' : mode == 'value' ? 'Select Changed Value' : ''"
          },
          "fontSize": {"value": 15},
          "fontWeight": {"value": "bold"},
          "opacity": {"signal": "mode != 'main' ? 1 : 0"}
        }
      }
    },

    {
      "name": "closeButton",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 680},
          "y": {"value": 28},
          "text": {"value": "✕"},
          "fontSize": {"value": 16},
          "cursor": {"value": "pointer"},
          "opacity": {"signal": "mode != 'main' ? 1 : 0"}
        }
      }
    },

    {
      "name": "fieldOption",
      "type": "rect",
      "from": {"data": "fieldPage"},
      "encode": {
        "update": {
          "x": {"value": 10},
          "y": {"signal": "45 + (datum.displayRow-1)*30"},
          "width": {"value": 670},
          "height": {"value": 29},
          "fill": {"value": "white"},
          "stroke": {"value": "#ddd"},
          "cursor": {"value": "pointer"}
        }
      }
    },

    {
      "name": "fieldOptionText",
      "type": "text",
      "from": {"data": "fieldPage"},
      "encode": {
        "update": {
          "x": {"value": 20},
          "y": {"signal": "65 + (datum.displayRow-1)*30"},
          "text": {"field": "key"},
          "fontSize": {"value": 13},
          "cursor": {"value": "pointer"}
        }
      }
    },

    {
      "name": "valueOption",
      "type": "rect",
      "from": {"data": "valuePage"},
      "encode": {
        "update": {
          "x": {"value": 10},
          "y": {"signal": "45 + (datum.displayRow-1)*30"},
          "width": {"value": 670},
          "height": {"value": 29},
          "fill": {"value": "white"},
          "stroke": {"value": "#ddd"},
          "cursor": {"value": "pointer"}
        }
      }
    },

    {
      "name": "valueOptionText",
      "type": "text",
      "from": {"data": "valuePage"},
      "encode": {
        "update": {
          "x": {"value": 20},
          "y": {"signal": "65 + (datum.displayRow-1)*30"},
          "text": {"field": "item.key"},
          "fontSize": {"value": 13},
          "cursor": {"value": "pointer"}
        }
      }
    },

    {
      "name": "prevButton",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 20},
          "y": {"value": 215},
          "text": {"value": "◀ Previous"},
          "fontSize": {"value": 12},
          "cursor": {"value": "pointer"},
          "opacity": {
            "signal": "mode != 'main' && page > 0 ? 1 : 0"
          }
        }
      }
    },

    {
      "name": "nextButton",
      "type": "text",
      "encode": {
        "update": {
          "x": {"value": 600},
          "y": {"value": 215},
          "text": {"value": "Next ▶"},
          "fontSize": {"value": 12},
          "cursor": {"value": "pointer"},
          "opacity": {
            "signal": "mode == 'field' ? (length(data('fields')) > (page+1)*5 ? 1 : 0) : mode == 'value' ? (length(data('values')) > (page+1)*5 ? 1 : 0) : 0"
          }
        }
      }
    }
  ]
}