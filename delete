SELECT
    TRUNC(emkd.MIN_PAY_DATE, 'MM') AS PAY_MONTH_DATE,
    TO_CHAR(TRUNC(emkd.MIN_PAY_DATE, 'MM'), 'YYYY-MM') AS PAY_YEAR_MONTH,

    et.EVENT_CODE_NAME,
    r.REGION_CODE,
    a.EVENT_OWNER,
    a.EVENT_CATEGORY,
    s.ASSET_CLASS,
    s.PRODUCT_TYPE,
    pu.UNIT_NAME,
    le.LEGAL_ENTITY_NAME,

    COUNT(DISTINCT a.ASPEN_EVENT_ID) AS TOTAL_EVENT_COUNT

FROM ANNOUNCEMENT a

INNER JOIN REGION r
    ON a.FK_REGION_ID = r.PK_REGION_CODE_ID

INNER JOIN EVENT_TYPE et
    ON a.FK_EVENT_TYPE_ID = et.PK_EVENT_TYPE_ID

INNER JOIN SECURITY s
    ON a.FK_SECURITY_ID = s.PK_SECURITY_ID

INNER JOIN PU_DATA pd
    ON a.PK_ANNOUNCEMENT_ID = pd.FK_ANNOUNCEMENT_ID

INNER JOIN PROCESSING_UNIT pu
    ON pd.FK_PROCESSING_UNIT_ID = pu.PK_PROCESSING_UNIT_ID

INNER JOIN HOLDING h
    ON pd.PK_PU_DATA_ID = h.FK_PU_DATA_ID

INNER JOIN LEGAL_ENTITY le
    ON h.FK_LEGAL_ENTITY_ID = le.PK_LEGAL_ENTITY_ID

INNER JOIN EVENT_MIN_KEY_DATES emkd
    ON a.PK_ANNOUNCEMENT_ID = emkd.PK_ANNOUNCEMENT_ID

WHERE
    emkd.MIN_PAY_DATE >= TIMESTAMP '2025-01-01 00:00:00'
    AND emkd.MIN_PAY_DATE < TIMESTAMP '2026-01-01 00:00:00'
    AND a.PROCESS_STATUS <> 'CANC'

GROUP BY
    TRUNC(emkd.MIN_PAY_DATE, 'MM'),
    et.EVENT_CODE_NAME,
    r.REGION_CODE,
    a.EVENT_OWNER,
    a.EVENT_CATEGORY,
    s.ASSET_CLASS,
    s.PRODUCT_TYPE,
    pu.UNIT_NAME,
    le.LEGAL_ENTITY_NAME;
